# ============================================================
# Lumen-Bailian 环境变量模板（复制为 .env 使用）
# ============================================================
#   cp .env.example .env
# .env 已被 .gitignore 忽略，真实密钥只放 .env，切勿提交。
# config.yml 保留非敏感的模型标识/开关；密钥一律放这里。
# ============================================================

# --- LLM（本地终端测试版：Volcengine ARK）---
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
DASHSCOPE_API_KEY=your-ark-api-key-here

# --- 联网搜索（Tavily）---
# 免费注册：https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here
